            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0locm8b1lxwccz1d1xdyu1depe0l'>
            <column caption='CY PROFIT' datatype='real' name='[Calculation_1610276694614027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1610276688179204] THEN [Profit] END' />
            </column>
            <column caption='PY PROFIT' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1610276695449612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) =  [Parameters].[Parameter 1610276688179204]-1 THEN [Profit] END' />
            </column>
            <column caption='DIFF % PROFIT' datatype='real' name='[Calculation_1610276695883790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1610276694614027]) - SUM([Calculation_1610276695449612]))/ SUM([Calculation_1610276695449612]) * 100' />
            </column>
            <column caption='{SUM([CY PROFIT])}' datatype='real' name='[Calculation_1610276700217360]' role='measure' type='quantitative' user:unnamed='KPI COUNT'>
              <calculation class='tableau' formula='{SUM([Calculation_1610276694614027])}' />
            </column>
            <column caption='{SUM([PY PROFIT])}' datatype='real' name='[Calculation_1610276700237841]' role='measure' type='quantitative' user:unnamed='KPI COUNT'>
