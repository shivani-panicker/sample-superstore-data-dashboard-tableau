            </column>
            <column caption='MIN MAX PROFIT' datatype='real' name='[Calculation_1610276701933587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_1610276694614027])= WINDOW_MAX(SUM([Calculation_1610276694614027])) THEN SUM([Calculation_1610276694614027])&#13;&#10;ELSEIF SUM([Calculation_1610276694614027])= WINDOW_MIN(SUM([Calculation_1610276694614027])) THEN SUM([Calculation_1610276694614027])&#13;&#10;END'>
